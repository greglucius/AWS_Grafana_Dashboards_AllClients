# Copy this file to terraform.tfvars and fill in your values.

aws_region  = "us-east-1"
aws_profile = "org-management"

spoke_accounts = {
  "client-alpha"   = "222222222222"
  "client-bravo"   = "333333333333"
  "client-charlie" = "444444444444"
}

# ---------- Grafana Cloud ----------
# Your Grafana Cloud stack URL — find at grafana.com/orgs/<org>/stacks
grafana_cloud_stack_url = "https://mycompany.grafana.net"

# Generate a service account token with Admin role at:
#   <stack>/org/serviceaccounts
# Keep this secret — store in a secrets manager or environment variable:
#   export TF_VAR_grafana_cloud_stack_sa_token="glsa_xxxxxxxxxxxx"
grafana_cloud_stack_sa_token = ""

# Optional: supply your own External ID (otherwise a UUID is generated).
# The same value must be used in spoke trust policies AND the data source.
# external_id = "3f8b9d0e-1a2b-4c5d-9e6f-7a8b9c0d1e2f"

tags = {
  Project     = "observability-hub-spoke"
  ManagedBy   = "terraform"
  Environment = "production"
}
